@page
@model IndexModel
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Workday Invoice Assistant</title><link rel="stylesheet" href="/site.css"></head><body>
<header><span>ASPEN GROVE / FINANCE TOOLS</span><h1>Workday Invoice Assistant</h1><p>Prepare an invoice draft; complete your final review in Workday before submitting.</p><strong class="badge">MOCK WORKDAY · No live requisitions · No submission capability</strong></header>
<main>
@if(Model.Notice is {} notice){<p class="notice" role="status">@notice</p>}
<section><h2>1. Add invoices</h2><p>Choose up to 20 PDF, PNG or JPEG invoices at once · 10 MB each, 50 MB total. Originals and processing history stay outside the source repository.</p><form method="post" enctype="multipart/form-data" asp-page-handler="Upload"><label>Invoices <input type="file" name="documents" accept=".pdf,.png,.jpg,.jpeg" multiple required></label><label><input type="checkbox" name="referenceOnly" value="true"> Development samples — permanently block mock draft creation for these documents</label><button>Upload batch locally</button></form><form method="post" asp-page-handler="Demo"><button class="secondary">Open synthetic example</button></form></section>
@if(Model.Selected is {} job){
<section><div class="eyebrow">CURRENT RECORD · @job.State</div><h2>@job.FileName</h2><p>Extraction source: @(string.IsNullOrEmpty(job.Provider)?"Not extracted":job.Provider)</p>
<p class="notice">@(job.ReferenceOnly ? "DEVELOPMENT SAMPLE — creation prohibited. " : "")@(job.IndependentlyChecked ? "Human source check recorded; Workday remains unverified." : "UNVERIFIED — final source review remains in Workday before submission.")</p><p>Uploaded pages: @job.UploadedPageCount · @job.DocumentKind</p><a asp-page-handler="Validation" asp-route-id="@job.Id">Download validation report</a>@if(job.Hash!="SYNTHETIC-DEMO"){<p><a asp-page-handler="Document" asp-route-id="@job.Id">Download original for comparison</a></p>}
@if(job.State is "Uploaded" or "ExtractionFailed" or "ExtractionInterrupted"){
<details><summary>Optional AI extraction</summary><p>Requires BYU approval before sending real invoice documents to OpenAI. Local transcription/import is available without an API call.</p><form method="post" asp-page-handler="Extract"><input type="hidden" name="id" value="@job.Id"><label><input type="checkbox" name="consent" value="true" required> Send this document to OpenAI for extraction (API charges may apply).</label><button>Extract invoice</button></form></details>}
@if(!Rules.CreationBlocked(job.State)){<details><summary>Import locally transcribed invoice JSON</summary><p>Import structured data from a local review without an API key. Imports remain unverified and never change development-only status.</p><form method="post" enctype="multipart/form-data" asp-page-handler="Import"><input type="hidden" name="id" value="@job.Id"><input type="file" name="extraction" accept=".json" required><button>Import for review</button></form></details>}@if(job.Invoice is {} invoice){
<h2>2. Invoice summary</h2><div class="metrics"><div><small>Supplier</small><strong>@invoice.Supplier</strong></div><div><small>Invoice</small><strong>@invoice.InvoiceNumber</strong></div><div><small>Total (@invoice.Currency)</small><strong>@invoice.Total?.ToString("0.00")</strong></div><div><small>Lines / payment</small><strong>@invoice.Lines.Count / @invoice.PaymentStatus</strong></div></div>
<p>Date: @invoice.InvoiceDate · Proposed Workday request type: Goods · UOM: Each (weight-priced mapping blocked for review) · Internal memo: Invoice @invoice.InvoiceNumber</p>
<details class="line-review"><summary>Invoice details for final review · @invoice.Lines.Count lines</summary><div class="tablewrap"><table><thead><tr><th>Line</th><th>Full description / source</th><th>Ordered / shipped</th><th>Pack / weight</th><th>Pricing basis / quantity</th><th>Original UOM</th><th>Unit price</th><th>Extended</th><th>Coding suggestion</th></tr></thead><tbody>
@for(int n=0;n<invoice.Lines.Count;n++){var line=invoice.Lines[n];<tr><td>@(n+1)</td><td>@Rules.RequestDescription(line)</td><td>@line.OrderedQuantity / @line.ShippedQuantity<br>@line.FulfillmentStatus</td><td>@line.PackSize<br>@line.Weight @line.WeightUom</td><td>@line.PricingBasis / @line.PricingQuantity</td><td>@line.Uom</td><td>@line.UnitPrice</td><td>@line.ExtendedAmount</td><td>@line.Coding<br>@line.CodingReason</td></tr>}
</tbody></table></div></details>
<p>Printed pages: @invoice.PrintedPageLabels · Declared count: @invoice.DeclaredPageCount · Completeness: @invoice.Completeness · Total type: @invoice.TotalKind</p><p>Subtotal: @invoice.Subtotal · Tax: @invoice.Tax · Other charges: @invoice.OtherCharges</p><p>Historical references (unverified): @string.Join(", ",invoice.HistoricalReferences ?? [])</p><h3>Programmed validation</h3>@foreach(var warning in Rules.ReviewWarnings(invoice,job.UploadedPageCount)){<p class="notice">Review warning: @warning</p>}
@if(Model.Issues.Count==0){<p class="notice">Automated arithmetic and required-field checks pass. The record remains UNVERIFIED; final source review remains in Workday before submission.</p>}else{<ul class="issues">@foreach(var issue in Model.Issues){<li>@issue</li>}</ul>}
<h3>Duplicate checks</h3><p>Local history: @(Model.Duplicates.Count==0?"No candidates found":"Possible duplicates — saving blocked"). Workday: <strong>NOT CHECKED — mock mode</strong>.</p>
@foreach(var d in Model.Duplicates){<p><a asp-route-id="@d.Id">@d.FileName · @d.State</a></p>}
@if(!Rules.CreationBlocked(job.State)){
<details><summary>Correct structured data</summary><p>Edit the JSON below, preserving one entry per source line. Null means unknown. Resolve concerns from source evidence; never remove a concern merely to pass validation. Saving corrections reruns all checks.</p><form method="post" asp-page-handler="Review"><input type="hidden" name="id" value="@job.Id"><label for="invoiceJson">Invoice JSON</label><textarea id="invoiceJson" name="invoiceJson" rows="24" spellcheck="false">@System.Text.Json.JsonSerializer.Serialize(invoice,Store.Json)</textarea><button>Save corrections &amp; validate</button></form><h3>Locked coding pairs</h3><ul>@foreach(var pair in Rules.Coding){<li>@pair.Key — @pair.Value</li>}</ul></details>}
<h2>3. Draft plan by Coding suggestion</h2><p>Each distinct coding pair gets a separate draft; every original invoice line stays separate. These are local mock drafts only. The final user review belongs in Workday before submission.</p>
<div class="tablewrap"><table><thead><tr><th>Coding pair</th><th>Purchase Category</th><th>Invoice lines</th><th>Category subtotal</th><th>Mock draft</th></tr></thead><tbody>@foreach(var group in Rules.CategoryGroups(invoice)){var draft=job.DraftGroups.FirstOrDefault(x=>x.CodingPair==group.CodingPair);<tr><td>@(string.IsNullOrWhiteSpace(group.CodingPair)?"UNRESOLVED":group.CodingPair)</td><td>@(group.Category??"UNRESOLVED")</td><td>@string.Join(", ",group.Lines.Select(x=>x.Number)) (@group.Lines.Count)</td><td>@group.Subtotal?.ToString("0.00")</td><td>@(draft?.Result?.Number ?? draft?.State ?? "Preview")</td></tr>}</tbody></table></div>
<details><summary>SharePoint expense-row preview · @Model.SharePointRows.Count row(s)</summary><p>One row per invoice/category pair. Total Cost is the confirmed category subtotal. No SharePoint connector is configured, so choice values and unresolved fields are not write-ready.</p>@foreach(var row in Model.SharePointRows){<h3>@(row.Category??"Unresolved category") · @row.CodingPair</h3><p>@row.LineCount invoice line(s) · Subtotal @(row.Subtotal?.ToString("0.00")??"unresolved")</p><div class="tablewrap"><table><thead><tr><th>Field</th><th>Proposed value</th><th>Requirement / mapping state</th></tr></thead><tbody>@foreach(var field in row.Fields){<tr><td>@field.Name</td><td>@(field.Value??"—")</td><td>@(field.Required?"Required":"Optional") · @field.Status</td></tr>}</tbody></table></div>}</details>
<h2>4. Create category mock drafts</h2><p>Automated validation and local duplicate checks run before creation. The invoice remains UNVERIFIED; nothing is written to live Workday or SharePoint.</p><form method="post" asp-page-handler="Mock"><input type="hidden" name="id" value="@job.Id"><button disabled="@(job.ReferenceOnly || !job.UploadedPageCount.HasValue || Model.Issues.Count>0 || Model.Duplicates.Count>0 || Rules.CreationBlocked(job.State))">Create mock drafts</button></form>
@if(job.DraftGroups.Count>0){<h3>Category draft results</h3><ul>@foreach(var draft in job.DraftGroups){<li>@draft.CodingPair — @draft.PurchaseCategory — @draft.LineCount line(s) — @draft.Total.ToString("0.00") — @draft.State @(draft.Result is null?"":$"· {draft.Result.Number} · {draft.Result.Status}")</li>}</ul>}
}
@if(job.State is "SaveUncertain" or "SaveIntent" or "DraftGroupsUncertain" or "DraftGroupsInProgress"){<form method="post" asp-page-handler="Reconcile"><input type="hidden" name="id" value="@job.Id"><p>Creation is blocked. Reconciliation only reads existing mock results; it never retries a write.</p><button>Reconcile mock results</button></form>}
@if(job.Result is {} result){<div class="notice"><h3>MOCK completion report</h3><p>Invoice @job.Invoice?.InvoiceNumber · Requisition @result.Number · Supplier @result.Supplier · @result.Total.ToString("0.00") USD · @result.LineCount lines · @result.Status</p><p>Duplicate check: local history checked at save; live Workday not checked. Remaining: establish BYU access, verify live coding and draft behavior, attach invoice and submit manually when authorized. This mock is not a real requisition.</p></div>}
<details><summary>Processing history</summary><ul>@foreach(var entry in job.Events){<li>@entry</li>}</ul></details></section>
}
<section><h2>Processing history</h2><p>Open a record to resume review. Uncertain saves stay blocked.</p>@if(Model.Jobs.Count==0){<p>No documents yet.</p>}@foreach(var j in Model.Jobs){<p><a asp-route-id="@j.Id">@j.FileName</a> <span class="badge">@j.State</span></p>}</section>
</main><footer>Matt · BYU Aspen Grove · Local milestone 1</footer></body></html>

