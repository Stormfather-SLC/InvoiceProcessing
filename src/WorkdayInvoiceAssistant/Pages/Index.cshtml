@page
@model IndexModel
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Workday Invoice Assistant</title>
    <link rel="stylesheet" href="/site.css">
</head>
<body>
<header>
    <span>ASPEN GROVE / FINANCE TOOLS</span>
    <h1>Workday Invoice Assistant</h1>
    <p>Select invoices, start processing, then review the prepared draft in Workday.</p>
    <strong class="badge">MOCK WORKDAY · No live requisitions · No submission capability</strong>
</header>
<main>
    @if (Model.Notice is { } notice) { <p class="notice" role="status">@notice</p> }

    <section class="intake">
        <h2>1. Select invoice files</h2>
        <p>Choose one or more PDF, PNG or JPEG files. Up to 20 files, 10 MB each, 50 MB total.</p>
        <form id="startForm" method="post" enctype="multipart/form-data" asp-page-handler="Upload">
            <label for="documents">Invoices</label>
            <input id="documents" type="file" name="documents" accept=".pdf,.png,.jpg,.jpeg" multiple required>
            <span class="step-label">2. Start</span>
            <button id="startButton" type="submit">Start</button>
            <div id="uploadProgress" class="upload-progress" role="status" hidden>
                <progress></progress><span>Receiving files and checking them locally…</span>
            </div>
        </form>
        <p class="privacy-note">Files stay on this computer. Automatic external processing is not active.</p>
    </section>

    @if (Model.Selected is { } job)
    {
        <section class="status-card" aria-live="polite">
            @if (job.DraftGroups.Count > 0 && job.DraftGroups.All(d => d.State == "MockDraftVerified"))
            {
                <h2>4. Draft preparation complete</h2>
                <p class="notice">Mock drafts are ready. They are not in Workday. Invoice data remains UNVERIFIED; final review must happen in Workday before submission.</p>
                <ul class="completion-list">
                @foreach (var draft in job.DraftGroups)
                {
                    <li><strong>@draft.PurchaseCategory</strong> · @draft.LineCount line(s) · @draft.Total.ToString("0.00") · @draft.Result?.Number · Draft (MOCK)</li>
                }
                </ul>
                <a class="workday-link" href="https://www.myworkday.com/byu/d/task/2997$16885.htmld" target="_blank" rel="noopener">Open Workday requisition task</a>
                <p class="small-note">This opens the task only; it does not open a requisition created by this app.</p>
            }
            else if (job.Invoice is null)
            {
                <h2>3. Processing status</h2>
                <ol class="steps"><li class="done">Files received and checked</li><li>Prepare invoice data</li><li>Create Workday draft</li></ol>
                <p class="notice">Files are stored locally. Automatic extraction is paused until BYU approves sending invoice data to an external API. No Workday requisition was created.</p>
            }
            else
            {
                <h2>3. Processing status</h2>
                <ol class="steps"><li class="done">Files received and checked</li><li class="done">Invoice data prepared</li><li>Create Workday draft</li></ol>
                <p class="notice">Invoice data is ready. Workday is mock-only in this version; no live requisition has been created.</p>
            }
        </section>

        <details class="more-details">
            <summary>Optional processing details</summary>
            <p><strong>@job.FileName</strong> · @job.State · @job.UploadedPageCount page(s)</p>
            @if (job.Invoice is { } invoice)
            {
                <p>@invoice.Supplier · Invoice @invoice.InvoiceNumber · @invoice.Currency @invoice.Total?.ToString("0.00") · @invoice.Lines.Count line(s)</p>
                @if (job.DraftGroups.Count == 0 && !Rules.CreationBlocked(job.State))
                {
                    <p>Automated checks: @(Model.Issues.Count == 0 ? "passed" : "need attention") · Local duplicate check: @(Model.Duplicates.Count == 0 ? "no candidates" : "possible duplicate")</p>
                    @if (Model.Issues.Count > 0) { <ul class="issues">@foreach (var issue in Model.Issues) { <li>@issue</li> }</ul> }
                    @if (Model.Duplicates.Count > 0) { <p>Possible duplicate records: @string.Join(", ", Model.Duplicates.Select(d => d.FileName))</p> }
                }
                @if (job.DraftGroups.Count > 0)
                {
                    <h3>Drafts by coding category</h3>
                    <ul>@foreach (var draft in job.DraftGroups) { <li>@draft.CodingPair — @draft.PurchaseCategory — @draft.LineCount line(s) — @draft.Total.ToString("0.00") — @draft.State</li> }</ul>
                }
                <details><summary>Invoice line data</summary>
                    <div class="tablewrap"><table><thead><tr><th>Line</th><th>Description</th><th>Quantity</th><th>Unit price</th><th>Extended</th><th>Coding suggestion</th></tr></thead><tbody>
                    @for (int n = 0; n < invoice.Lines.Count; n++) { var line = invoice.Lines[n]; <tr><td>@(n + 1)</td><td>@Rules.RequestDescription(line)</td><td>@line.Quantity</td><td>@line.UnitPrice</td><td>@line.ExtendedAmount</td><td>@line.Coding</td></tr> }
                    </tbody></table></div>
                </details>
                <details><summary>SharePoint row preview · @Model.SharePointRows.Count row(s)</summary>
                    <p>Preview only. Nothing is written to SharePoint.</p>
                    @foreach (var row in Model.SharePointRows)
                    {
                        <h3>@row.Category · @row.CodingPair · Total Cost @row.Subtotal?.ToString("0.00")</h3>
                        <ul>@foreach (var field in row.Fields) { <li>@field.Name: @(field.Value ?? "—") · @field.Status</li> }</ul>
                    }
                </details>
                <details><summary>Advanced recovery and import tools</summary>
                    @if (job.State is "Uploaded" or "ExtractionFailed" or "ExtractionInterrupted")
                    {
                        <p>API extraction remains unavailable until institutional approval is confirmed.</p>
                    }
                    @if (!Rules.CreationBlocked(job.State))
                    {
                        <form method="post" enctype="multipart/form-data" asp-page-handler="Import">
                            <input type="hidden" name="id" value="@job.Id">
                            <label for="extraction">Import locally transcribed invoice JSON</label>
                            <input id="extraction" type="file" name="extraction" accept=".json" required>
                            <button>Import invoice data</button>
                        </form>
                    }
                    @if (!job.ReferenceOnly && Model.Issues.Count == 0 && Model.Duplicates.Count == 0 && job.Invoice is not null && !Rules.CreationBlocked(job.State))
                    {
                        <form method="post" asp-page-handler="Mock"><input type="hidden" name="id" value="@job.Id"><button>Create local mock drafts</button></form>
                    }
                    @if (job.State is "SaveUncertain" or "SaveIntent" or "DraftGroupsUncertain" or "DraftGroupsInProgress")
                    {
                        <form method="post" asp-page-handler="Reconcile"><input type="hidden" name="id" value="@job.Id"><p>Uncertain mock saves must be reconciled before retry.</p><button>Reconcile mock results</button></form>
                    }
                </details>
            }
            @if (job.Hash == "SYNTHETIC-DEMO-CATEGORIES")
            {
                <p><a asp-page-handler="Validation" asp-route-id="@job.Id">Download synthetic validation report</a></p>
            }
        </details>
    }

    <details class="history">
        <summary>Processing history (@Model.Jobs.Count)</summary>
        @if (Model.Jobs.Count == 0) { <p>No files processed yet.</p> }
        @foreach (var item in Model.Jobs) { <p><a asp-route-id="@item.Id">@item.FileName</a> · @item.State</p> }
    </details>

    <details class="demo-tools">
        <summary>Open a synthetic example</summary>
        <p>Uses invented data only and creates local mock drafts.</p>
        <form method="post" asp-page-handler="Demo"><button class="secondary">Open synthetic example</button></form>
    </details>
</main>
<footer>Matt · BYU Aspen Grove · Local milestone 1</footer>
<script>
    document.getElementById('startForm')?.addEventListener('submit', function () {
        const files = document.getElementById('documents');
        if (!files.files.length) return;
        document.getElementById('startButton').disabled = true;
        document.getElementById('uploadProgress').hidden = false;
    });
</script>
</body>
</html>
